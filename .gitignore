# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ────────────────────────────────────────────────
# Go
# ────────────────────────────────────────────────

/monkey
/monk

# Binaries, libraries, and test binaries
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test

# Output of `go test -c` / `go build -o bin/...`
/bin/
/dist/

# Coverage and profiling output
*.out
*.prof
coverage.txt
coverage.html

# Workspace files (local-only; not needed for a single-module project)
go.work
go.work.sum

# Vendored dependencies (uncomment if you don't want to commit them)
# vendor/

# ────────────────────────────────────────────────
# Env / secrets
# ────────────────────────────────────────────────

.env
.env.*
!.env.example
*.pem

# ────────────────────────────────────────────────
# Logs / temp
# ────────────────────────────────────────────────

logs/
*.log
tmp/
.cache/

# ────────────────────────────────────────────────
# IDEs and editors
# ────────────────────────────────────────────────

.idea/
*.swp
*.swo
*~
*.sublime-workspace

.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ────────────────────────────────────────────────
# System / OS files
# ────────────────────────────────────────────────

.DS_Store
Thumbs.db
/bin/
